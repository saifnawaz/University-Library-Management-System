# Copy this file to .env and fill in real values. Never commit .env.
# Google Gemini key for the chat assistant. Empty = the assistant answers with a
# polite "not available" message instead.
GEMINI_API_KEY=
# Optional. Which Gemini model to use.
GEMINI_MODEL=gemini-3.5-flash
# Optional, default 1. 1: questions the keyword check misses are classified by Gemini
# (a second call). 0: the keyword check alone, so each question uses one Gemini call.
LLM_TOPIC_GUARD=1
FLASK_SECRET_KEY=change-me
# Optional. Defaults to library.db in the project folder.
LIBRARY_DB_PATH=library.db
# Optional. Port for python app.py; defaults to 8765.
PORT=8765
# Optional. 1 turns on demo mode: demo logins on the sign-in page and a "Reset demo data" button.
# Leave it at 0 for a real library.
DEMO_MODE=0
